---
import { Image } from "astro:assets";
import imgRegistro from "../../assets/CuerpoIndex/re.webp";
---

<section class="join-cta scroll-animate">
    <div class="cta-media-wrapper">
        <Image
            src={imgRegistro}
            alt="Fondo Reclutamiento"
            class="cta-video-bg"
            widths={[320, 480, 640, 800, 1024, 1280]}
            sizes="(max-width: 480px) 100vw, (max-width: 768px) 100vw, 100vw"
            format="webp"
            quality={70}
            loading="lazy"
            decoding="async"
        />
        <div class="cta-overlay"></div>
    </div>
    <div class="join-cta__text">
        <h2>ÚNETE A LA ESCUDERÍA</h2>
        <p class="join-cta__subtitle">
            El proceso de selección y reclutamiento se encuentra en pausa hasta
            nuevo aviso. Sin embargo, nuestra convocatoria se mantiene abierta.
            Deja tus datos en el formulario para contactarte en cuanto
            reanudemos las actividades.
        </p>
        <a href="/join" class="btn-underline">DEJA TUS DATOS</a>
    </div>
</section>
