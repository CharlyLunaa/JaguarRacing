---
// Interfaz Educativa Jaguar Racing - Metodología y Fundamentos (Z-Pattern Layout)
const areas = [
    {
        id: 'powertrain',
        title: 'TRANSFERENCIA DE POTENCIA',
        subtitle: 'POWERTRAIN',
        desc: 'Optimización de la cadena cinemática desde el motor Briggs & Stratton 10HP hasta el eje trasero mediante una CVT Comet 780 calibrada en conjunto con una caja reductora de relación variable. El análisis por FEM en Altair HyperMesh validó la resistencia de los componentes bajo picos de torque superiores a 65 Nm, garantizando una eficiencia de transferencia mayor al 88% en los regímenes de operación exigidos por la normativa SAE Baja 2026.',
        videoFile: 'F-GB.mp4', 
    },
    {
        id: 'suspension',
        title: 'CINEMÁTICA Y AMORTIGUACIÓN',
        subtitle: 'SUSPENSIÓN',
        desc: 'Arquitectura de doble horquilla con un KPI (King Pin Inclination) de 41.34°, seleccionado mediante iteraciones de análisis cinemático en Altair MotionView para maximizar la recuperación de camber bajo deflexión severa. La geometría garantiza contacto neumático constante en superficies de hasta 30° de inclinación, controlando el centro de balanceo dinámico y la distribución de cargas para minimizar el riesgo de vuelco en los artículos de terreno del reglamento.',
        videoFile: 'Front susp der.mp4',
    },
    {
        id: 'frenos',
        title: 'SISTEMA DE FRENADO Y SEGURIDAD',
        subtitle: 'FRENOS',
        desc: 'Sistema hidráulico de circuito dual con un balance de frenado F/R ajustado al 62/38% para prevenir el bloqueo prematuro del eje trasero. El dimensionamiento térmico de los rotores, validado mediante simulación FEM en Ansys Thermal, garantiza la disipación de 3.2 kJ por evento de frenado sin superar los 280°C en el disco. La presión máxima de línea se estableció en 9.5 MPa, cumpliendo holgadamente los márgenes de seguridad del Artículo 4 del reglamento SAE Baja.',
        videoFile: 'B-GB.mp4',
    },
    {
        id: 'direccion',
        title: 'GEOMETRÍA DE MANIOBRA',
        subtitle: 'DIRECCIÓN',
        desc: 'Mecanismo de piñón y cremallera con geometría de Ackermann optimizada al 74%, logrando un radio de giro interno agresivo de 1.53 m (60 in) en cumplimiento con la normativa SAE. El ensamble del housing fue simulado en LS-DYNA bajo picos de torque de 65 Nm, registrando un esfuerzo máximo de Von Mises de 244.5 MPa con un factor de seguridad de 1.4 sobre el límite de fluencia del material. El rediseño compacto redujo el empaquetado del sistema en un 15% respecto a la iteración anterior.',
        videoFile: 'Ensamble Housin JR25.mp4',
    }
];
---

<section class="eng-section">
    <div class="eng-container">
        {areas.map((area, i) => (
            <article class={`eng-feature ${i % 2 !== 0 ? 'is-reversed' : ''}`} id={`feature-${area.id}`}>
                <div class="feature-video-wrapper">
                    <div class="video-frame">
                        <video 
                            src={`/actualizaciones/videos/${area.videoFile}`}
                            class="cad-native-video"
                            autoplay 
                            loop 
                            muted 
                            playsinline
                            disablepictureinpicture
                        ></video>
                    </div>
                </div>
                
                <div class="feature-info">
                    <span class="feature-subtitle">{area.subtitle}</span>
                    <h2 class="feature-title">{area.title}</h2>
                    <p class="feature-desc">{area.desc}</p>
                </div>
            </article>
        ))}
    </div>
</section>

<!-- El bloque <style> no cambia; se conserva íntegro -->
<style>
    .eng-section {
        background: var(--bg-black);
        padding: 4rem clamp(1.5rem, 5vw, 4rem) 6rem;
    }
    .eng-container {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 6rem;
    }
    .eng-feature {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: center;
    }
    .eng-feature.is-reversed { direction: rtl; }
    .eng-feature.is-reversed > * { direction: ltr; }
    .feature-video-wrapper { position: relative; width: 100%; }
    .video-frame {
        position: relative;
        padding-top: 56.25%;
        background: #050505;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid rgba(166, 124, 0, 0.15);
        box-shadow: 0 20px 40px rgba(0,0,0,0.4);
        transition: transform 0.4s ease, box-shadow 0.4s ease;
    }
    .video-frame:hover {
        transform: translateY(-5px);
        box-shadow: 0 30px 50px rgba(0,0,0,0.6);
        border-color: rgba(166, 124, 0, 0.3);
    }
    .cad-native-video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        pointer-events: none;
    }
    .feature-info { display: flex; flex-direction: column; justify-content: center; }
    .feature-subtitle {
        color: var(--text-gray);
        font-family: var(--font-main);
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 3px;
        margin-bottom: 0.5rem;
        display: block;
    }
    .feature-desc { color: var(--text-gray); line-height: 1.7; margin: 0; max-width: 90%; }
    @media (max-width: 900px) {
        .eng-container { gap: 4rem; }
        .eng-feature, .eng-feature.is-reversed {
            grid-template-columns: 1fr;
            direction: ltr;
            gap: 2rem;
            text-align: center;
        }
        .feature-info { align-items: center; }
        .feature-title { text-align: center; }
        .feature-desc { max-width: 100%; text-align: center; }
    }
</style>